{
  "name": "interruptible-rime-agent",
  "version": "1.0.0",
  "description": "Full-duplex interruptible voice AI assistant powered by Rime TTS with sub-30ms cancellation and generation fencing.",
  "type": "module",
  "main": "server/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test tests/*.test.js",
    "test:visual": "node tests/visual-chat.test.js",
    "test:workspace": "node tests/workspace-scenarios.test.js",
    "test:routing": "node tests/routing-scenarios.test.js",
    "test:barge-in": "node tests/interruption.test.js",
    "test:all": "node --test tests/**/*.test.js",
    "benchmark": "node benchmarks/barge-in-benchmark.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "voice-ai",
    "rime-tts",
    "interruption",
    "barge-in",
    "realtime",
    "full-duplex",
    "websockets"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
