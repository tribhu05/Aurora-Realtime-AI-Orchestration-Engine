# Server Configuration
PORT=3000
FRONTEND_URL=https://aurora-realtime-ai-orchestration-engine.vercel.app

# Rime Text-to-Speech (TTS) Configuration
# Get your API key from https://rime.ai dashboard
RIME_API_KEY=your_rime_api_key_here
# Supported production models: mistv3 (ultra-low latency sub-100ms) or coda (expressive)
RIME_MODEL_ID=mistv3
# Available speakers: celeste, astra, colin, marina, spencer
RIME_SPEAKER=celeste
# Audio output format: mp3 or wav
RIME_AUDIO_FORMAT=mp3

# LLM Provider Configuration
# Supported providers: groq, openai, openrouter
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
# Recommended fast models:
# For Groq: llama-3.1-8b-instant
# For OpenAI: gpt-4o-mini
LLM_MODEL=llama-3.1-8b-instant

# Debug / Stress Testing Mode (true / false)
DEBUG_METRICS=true
ARTIFICIAL_DELAY_MS=0
