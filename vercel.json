{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?1=$1" },
    { "source": "/health", "destination": "/api/index.js?1=health" },
    { "source": "/config", "destination": "/api/index.js?1=config" },
    { "source": "/(.*)", "destination": "/client/$1" }
  ]
}
