{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/config", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/client/$1" }
  ]
}
